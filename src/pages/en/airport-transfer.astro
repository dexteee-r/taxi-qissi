---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n/dictionary.js';
import { seo } from '../../i18n/seo.js';
import { localePath } from '../../i18n/routes.js';
import { DESTINATIONS, AIRPORT_IDS } from '../../data/destinations.js';

const locale = 'en';
const s = t(locale);
const meta = seo[locale].airport;
const airports = DESTINATIONS.filter((d) => AIRPORT_IDS.includes(d.id));
---

<BaseLayout locale={locale} pageKey="airport" title={meta.title} description={meta.description}>
  <section class="container" style="padding-block:56px">
    <div class="airport-hero">
      <div>
        <h1 style="font-size:clamp(32px,4vw,44px);letter-spacing:-.038em">{s.aTitle}</h1>
        <p style="font-size:17px;color:var(--color-text-muted);max-width:46ch">{s.aSub}</p>
        <a class="btn btn-dark qissi-tap" href={localePath(locale, 'rates')}>{s.aCtaBtn}</a>
      </div>
      <div style="width:100%;height:240px;background:var(--color-border);border-radius:9px;display:flex;align-items:center;justify-content:center;color:var(--color-text-faint);font-size:13px">
        Vehicle + luggage photo
      </div>
    </div>

    <h2 style="margin-top:44px">{s.aListTitle}</h2>
    <div class="airport-list">
      {airports.map((a) => (
        <div class="airport-row">
          <span style="display:flex;align-items:center;gap:14px">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 13.5 21 6l-6.5 13-2.5-6-9-1.5Z"/></svg>
            <span style="display:flex;flex-direction:column;gap:2px">
              <span class="name">{a[locale]}</span>
              <span class="meta">{s.aPending}</span>
            </span>
          </span>
          <span class="price">— €</span>
        </div>
      ))}
    </div>
    <p style="display:flex;gap:9px;font-size:13.5px;color:var(--color-text-faint);margin-top:16px">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;margin-top:2px"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.5"/></svg>
      {s.aPendingNote}
    </p>
  </section>
</BaseLayout>

<style>
  .airport-hero {
    display: grid;
    gap: 32px;
    align-items: start;
    margin-bottom: 44px;
  }
  @media (min-width: 900px) {
    .airport-hero {
      grid-template-columns: 1fr 1fr;
      gap: 64px;
    }
  }
</style>
