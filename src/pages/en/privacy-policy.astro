---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { seo } from '../../i18n/seo.js';
import { LEGAL } from '../../data/legal.js';

const locale = 'en';
const meta = seo[locale].privacy;
const legal = LEGAL[locale].privacy;
---

<BaseLayout locale={locale} pageKey="privacy" title={meta.title} description={meta.description}>
  <section class="container legal-page section-first">
    <h1 class="h-legal">{legal.title}</h1>
    <h2>{legal.h1}</h2>
    <p>{legal.p1}</p>
    <h2>{legal.h2}</h2>
    <p>{legal.p2}</p>
    <h2>{legal.h3}</h2>
    <p>{legal.p3}</p>
  </section>
</BaseLayout>
