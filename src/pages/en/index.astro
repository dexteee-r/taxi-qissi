---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n/dictionary.js';
import { seo } from '../../i18n/seo.js';
import { localePath } from '../../i18n/routes.js';
import CallButton from '../../components/CallButton.astro';
import WhatsAppButton from '../../components/WhatsAppButton.astro';
import FaqSection from '../../components/FaqSection.astro';
import content from '../../content/en/home.json';

const locale = 'en';
const strings = t(locale);
const meta = seo[locale].home;
---

<BaseLayout locale={locale} pageKey="home" title={meta.title} description={meta.description}>
  <section class="container hero">
    <h1>{content.heroTitle}</h1>
    <p>{content.heroSubtitle}</p>
    <div class="hero-actions">
      <CallButton locale={locale} />
      <WhatsAppButton locale={locale} />
    </div>
  </section>

  <section class="container">
    <p>{content.intro}</p>
  </section>

  <section class="container">
    <h2>{strings.nav.services}</h2>
    <p><a href={localePath(locale, 'services')}>{strings.common.readMore}</a></p>
  </section>

  <section class="container">
    <h2>{content.zoneTitle}</h2>
    <p>{content.zoneIntro}</p>
  </section>

  <div class="container">
    <FaqSection title={content.faqTitle} items={content.faq} />
  </div>
</BaseLayout>

<style>
  .hero {
    padding-block: 2.5rem;
  }
  .hero-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }
</style>
