---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n/dictionary.js';
import { seo } from '../../i18n/seo.js';
import { BUSINESS } from '../../config/business.js';
import { WHATSAPP_PLAIN_URL } from '../../lib/whatsapp.js';
import ContactDetails from '../../components/ContactDetails.astro';
import ServiceAreaMap from '../../components/ServiceAreaMap.astro';
import MessageTips from '../../components/MessageTips.astro';
import ReviewCta from '../../components/ReviewCta.astro';

const locale = 'en';
const s = t(locale);
const meta = seo[locale].contact;
---

<BaseLayout locale={locale} pageKey="contact" title={meta.title} description={meta.description}>
  <section class="container section-first">
    <div class="contact-grid">
      <div>
        <h1 class="h-page">{s.navContact}</h1>
        <p class="lead" style="max-width:40ch">{s.cSub}</p>

        <div class="contact-cta">
          <a class="btn btn-call qissi-tap" href={`tel:${BUSINESS.phone}`} data-analytics="call_click">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round"><path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 5.5 5.5L16 12l4 1.5v3a2 2 0 0 1-2.2 2A16 16 0 0 1 4 5.2 2 2 0 0 1 6.5 3Z"/></svg>
            <span style="font:700 17px/1 var(--font-display)">{BUSINESS.phoneDisplay}</span>
          </a>
          <a class="btn btn-whatsapp qissi-tap" href={WHATSAPP_PLAIN_URL} target="_blank" rel="noopener" data-analytics="whatsapp_click">
            <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.5 8.5 0 0 1-12.4 7.6L4 20.5l1.4-4.4A8.5 8.5 0 1 1 21 11.5Z"/></svg>
            {s.wa}
          </a>
        </div>

        <ContactDetails locale={locale} />
        <MessageTips locale={locale} />
        <ReviewCta locale={locale} />
      </div>

      <div>
        <ServiceAreaMap locale={locale} />
        <p class="sub" style="margin:12px 0 0">{s.zoneNote}</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .contact-grid {
    display: grid;
    gap: 24px;
  }
  @media (min-width: 900px) {
    .contact-grid {
      grid-template-columns: 1fr 1fr;
      gap: 64px;
      align-items: start;
    }
  }
</style>
