---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { seo } from '../../i18n/seo.js';
import content from '../../content/nl/privacy.json';

const locale = 'nl';
const meta = seo[locale].privacy;
---

<BaseLayout locale={locale} pageKey="privacy" title={meta.title} description={meta.description}>
  <div class="container">
    <p class="error-box">{content.draftWarning}</p>
    <h1>{content.title}</h1>
    <p>{content.intro}</p>

    {
      content.sections.map((section) => (
        <section>
          <h2>{section.heading}</h2>
          <p>{section.body}</p>
        </section>
      ))
    }
  </div>
</BaseLayout>
