---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { seo } from '../../i18n/seo.js';
import { LEGAL } from '../../data/legal.js';

const locale = 'nl';
const meta = seo[locale].legal;
const legal = LEGAL[locale].juridisch;
const company = 'Taxi QISSI · Tienen, België';
---

<BaseLayout locale={locale} pageKey="legal" title={meta.title} description={meta.description}>
  <section class="container legal-page section-first">
    <h1 class="h-legal">{legal.title}</h1>
    <h2>{legal.h1}</h2>
    <p>{legal.p1}</p>
    <h2>{legal.h2}</h2>
    <p>{legal.p2}</p>
    <h2>{legal.h3}</h2>
    <p>{legal.p3}</p>
    <h2>{legal.h4}</h2>
    <p>{legal.p4}</p>
    <div class="legal-footer">{company}</div>
  </section>
</BaseLayout>
