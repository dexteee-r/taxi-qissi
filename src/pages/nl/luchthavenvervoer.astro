---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import photoAeroport from '../../assets/taxi-aeroport.webp';
import { t } from '../../i18n/dictionary.js';
import { seo } from '../../i18n/seo.js';
import { localePath } from '../../i18n/routes.js';
import { DESTINATIONS, AIRPORT_IDS } from '../../data/destinations.js';
import { formatEuro } from '../../lib/format.js';

const locale = 'nl';
const s = t(locale);
const meta = seo[locale].airport;
const airports = DESTINATIONS.filter((d) => AIRPORT_IDS.includes(d.id));
---

<BaseLayout locale={locale} pageKey="airport" title={meta.title} description={meta.description}>
  <section class="container section-first">
    <div class="airport-hero">
      <div>
        <h1 class="h-page">{s.aTitle}</h1>
        <p class="lead" style="max-width:46ch">{s.aSub}</p>
        <a class="btn btn-dark qissi-tap airport-hero-cta" href={localePath(locale, 'rates')}>{s.aCtaBtn}</a>
      </div>
      {/* Astro fabrique les versions WebP et les tailles au build : le PNG
          d'origine (2 Mo) n'est jamais envoyé au visiteur, seulement la
          taille adaptée à l'écran. Chargement immédiat et non différé :
          l'image est visible dès l'ouverture de la page. */}
      <Image
        class="airport-media"
        src={photoAeroport}
        alt={s.aPhotoAlt}
        widths={[400, 800, 1200]}
        sizes="(min-width: 900px) 600px, 100vw"
        format="webp"
        loading="eager"
      />
    </div>

    <h2 class="h-section" style="margin-top:24px">{s.aListTitle}</h2>
    <div class="airport-list">
      {
        airports.map((a) => (
          <div class="airport-row">
            <span style="display:flex;align-items:center;gap:12px">
              <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M3 13.5 21 6l-6.5 13-2.5-6-9-1.5Z"/></svg>
              <span style="display:flex;flex-direction:column;gap:2px">
                <span class="name">{a[locale]}</span>
                <span class="meta">{a.price != null ? s.aFlat : s.aPending}</span>
              </span>
            </span>
            <span class="price">{a.price != null ? formatEuro(a.price, locale) : '— €'}</span>
          </div>
        ))
      }
    </div>
    <p class="zone-note">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;margin-top:3px"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.5"/></svg>
      {s.flatFareNote}
    </p>

    <div class="airport-cta">
      <span class="title">{s.aCtaTitle}</span>
      <p class="sub">{s.aCtaSub}</p>
      <a class="btn btn-dark qissi-tap" href={localePath(locale, 'rates')}>{s.aCtaBtn}</a>
    </div>
  </section>
</BaseLayout>

<style>
  .airport-hero {
    display: grid;
    gap: 16px;
    align-items: start;
  }
  @media (min-width: 900px) {
    .airport-hero {
      grid-template-columns: 1fr 1fr;
      gap: 64px;
      margin-bottom: 44px;
    }
  }
</style>
