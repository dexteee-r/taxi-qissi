---
// A static site serves exactly one physical 404 page regardless of URL
// prefix. To satisfy "page 404 traduite dans les trois langues"
// (brief §4 / CDC §5), all three translations are pre-rendered here and a
// small inline script shows the one matching the /nl|fr|en/ prefix the
// visitor was on. No-JS fallback: NL content, with links to switch.
import '../styles/global.css';
import { dictionary } from '../i18n/dictionary.js';
import { localePath, LOCALES, LOCALE_NAMES } from '../i18n/routes.js';
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{dictionary.nl.e404Title} / {dictionary.fr.e404Title} / {dictionary.en.e404Title}</title>
    <meta name="robots" content="noindex" />
    <link rel="preload" href="/fonts/satoshi-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <main class="container">
      {
        LOCALES.map((locale) => (
          <section class:list={['error-404', 'nf-block', { 'nf-hidden': locale !== 'nl' }]} data-locale={locale}>
            <span class="error-404-code">404</span>
            <h1>{dictionary[locale].e404Title}</h1>
            <p>{dictionary[locale].e404Sub}</p>
            <a class="btn btn-outline qissi-tap" href={localePath(locale, 'home')}>
              {dictionary[locale].e404Btn}
            </a>
          </section>
        ))
      }
      <nav class="footer-langs" style="margin-bottom:48px" aria-label="Language">
        {
          LOCALES.map((locale) => (
            <a href={localePath(locale, 'home')} lang={locale} style="border-color:var(--color-border-strong);color:var(--color-text)">
              {LOCALE_NAMES[locale]}
            </a>
          ))
        }
      </nav>
    </main>

    <style>
      .nf-hidden {
        display: none;
      }
    </style>

    <script>
      const prefix = window.location.pathname.split('/')[1];
      const locale = ['nl', 'fr', 'en'].includes(prefix) ? prefix : 'nl';
      document.documentElement.lang = locale;
      document.querySelectorAll('.nf-block').forEach((el) => {
        el.classList.toggle('nf-hidden', el.getAttribute('data-locale') !== locale);
      });
    </script>
  </body>
</html>
