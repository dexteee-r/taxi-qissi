---
// A static site serves exactly one physical 404 page regardless of URL
// prefix. To satisfy "page 404 traduite dans les trois langues"
// (brief §4 / CDC §5), all three translations are pre-rendered here and a
// small inline script shows the one matching the /nl|fr|en/ prefix the
// visitor was on. No-JS fallback: NL content, with links to switch.
import '../styles/global.css';
import { dictionary } from '../i18n/dictionary.js';
import { localePath, LOCALES } from '../i18n/routes.js';
import { BUSINESS } from '../config/business.js';
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{dictionary.nl.e404Title} / {dictionary.fr.e404Title} / {dictionary.en.e404Title}</title>
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link href="https://api.fontshare.com/v2/css?f[]=cabinet-grotesk@700,800&f[]=satoshi@400,500,700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main class="container" style="padding-block:96px;max-width:40rem">
      {
        LOCALES.map((locale) => (
          <section class:list={['nf-block', { 'nf-hidden': locale !== 'nl' }]} data-locale={locale}>
            <span class="error-404-code">404</span>
            <h1 style="margin-top:14px">{dictionary[locale].e404Title}</h1>
            <p style="color:var(--color-text-muted);max-width:44ch">{dictionary[locale].e404Sub}</p>
            <div style="display:flex;gap:12px;flex-wrap:wrap;margin-top:8px">
              <a class="btn btn-outline qissi-tap" href={localePath(locale, 'home')}>{dictionary[locale].e404Btn}</a>
              <a class="btn btn-call qissi-tap" href={`tel:${BUSINESS.phone}`}>{dictionary[locale].call} — {BUSINESS.phoneDisplay}</a>
            </div>
          </section>
        ))
      }
      <nav style="display:flex;gap:16px;margin-top:32px" aria-label="Language">
        {LOCALES.map((locale) => (
          <a href={localePath(locale, 'home')}>{locale.toUpperCase()}</a>
        ))}
      </nav>
    </main>

    <style>
      .nf-hidden {
        display: none;
      }
    </style>

    <script>
      const prefix = window.location.pathname.split('/')[1];
      const locale = ['nl', 'fr', 'en'].includes(prefix) ? prefix : 'nl';
      document.documentElement.lang = locale;
      document.querySelectorAll('.nf-block').forEach((el) => {
        el.classList.toggle('nf-hidden', el.getAttribute('data-locale') !== locale);
      });
    </script>
  </body>
</html>
