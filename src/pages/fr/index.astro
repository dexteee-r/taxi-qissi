---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n/dictionary.js';
import { seo } from '../../i18n/seo.js';
import { SERVICES, SERVICE_ICONS } from '../../data/services.js';
import { FAQS } from '../../data/faqs.js';
import HomeEstimator from '../../components/HomeEstimator.astro';
import ZoneSearch from '../../components/ZoneSearch.astro';
import ServicesGrid from '../../components/ServicesGrid.astro';
import FaqSection from '../../components/FaqSection.astro';

const locale = 'fr';
const s = t(locale);
const meta = seo[locale].home;
const services = SERVICES[locale].map((svc, i) => ({ ...svc, icon: SERVICE_ICONS[i] }));
---

<BaseLayout locale={locale} pageKey="home" title={meta.title} description={meta.description}>
  <section class="container section-first">
    <div class="hero-grid">
      <div>
        <h1 class="h-hero">{s.h1}</h1>
        <p class="lead-hero">{s.heroSub}</p>
        <span class="trust-row">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M4 12.5l5 5L20 6.5"/></svg>
          {s.trust2}
        </span>
      </div>
      <HomeEstimator locale={locale} />
    </div>
  </section>

  <div class="home-sections">
    <ZoneSearch locale={locale} />
    <section class="container section section-divider services-section">
      <h2 class="h-section">{s.servTitle}</h2>
      <p class="sub">{s.servSub}</p>
      <ServicesGrid services={services} />
    </section>
  </div>

  <FaqSection title={s.faqTitle} items={FAQS[locale]} />
</BaseLayout>
