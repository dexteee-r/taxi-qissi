---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n/dictionary.js';
import { seo } from '../../i18n/seo.js';
import { SERVICES, SERVICE_ICONS } from '../../data/services.js';
import ServicesLong from '../../components/ServicesLong.astro';

const locale = 'fr';
const s = t(locale);
const meta = seo[locale].services;
const services = SERVICES[locale].map((svc, i) => ({ ...svc, icon: SERVICE_ICONS[i] }));
---

<BaseLayout locale={locale} pageKey="services" title={meta.title} description={meta.description}>
  <section class="container section-first">
    <h1 class="h-page">{s.servTitle}</h1>
    <p class="lead" style="max-width:52ch">{s.sSub}</p>
    <ServicesLong services={services} />
  </section>
</BaseLayout>
