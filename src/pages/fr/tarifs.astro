---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n/dictionary.js';
import { seo } from '../../i18n/seo.js';
import RatesTable from '../../components/RatesTable.astro';
import DestinationsSummary from '../../components/DestinationsSummary.astro';
import PriceSimulator from '../../components/PriceSimulator.astro';

const locale = 'fr';
const s = t(locale);
const meta = seo[locale].rates;
---

<BaseLayout locale={locale} pageKey="rates" title={meta.title} description={meta.description}>
  <section class="container section-first">
    <div class="rates-grid">
      <div>
        <h1 class="h-page">{s.pTitle}</h1>
        <p class="lead">{s.pSub}</p>
        <RatesTable locale={locale} />
        <DestinationsSummary locale={locale} />
      </div>
      <PriceSimulator locale={locale} />
    </div>
  </section>
</BaseLayout>
