---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t } from '../../i18n/dictionary.js';
import { seo } from '../../i18n/seo.js';
import RatesTable from '../../components/RatesTable.astro';
import PriceSimulator from '../../components/PriceSimulator.astro';

const locale = 'fr';
const s = t(locale);
const meta = seo[locale].rates;
---

<BaseLayout locale={locale} pageKey="rates" title={meta.title} description={meta.description}>
  <section class="container" style="padding-block:56px">
    <div class="rates-grid">
      <div>
        <h1 style="font-size:clamp(32px,4vw,44px);letter-spacing:-.038em">{s.pTitle}</h1>
        <p style="font-size:17px;color:var(--color-text-muted);max-width:44ch">{s.pSub}</p>
        <RatesTable locale={locale} />
      </div>
      <PriceSimulator locale={locale} />
    </div>
  </section>
</BaseLayout>

<style>
  .rates-grid {
    display: grid;
    gap: 40px;
  }
  @media (min-width: 900px) {
    .rates-grid {
      grid-template-columns: 1fr 1.1fr;
      align-items: start;
    }
  }
</style>
