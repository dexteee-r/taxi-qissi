---
import '../styles/global.css';
import { alternates, localePath, DEFAULT_LOCALE } from '../i18n/routes.js';
import { t } from '../i18n/dictionary.js';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileCallBar from '../components/MobileCallBar.astro';
import SchemaOrg from '../components/SchemaOrg.astro';
import Analytics from '@vercel/analytics/astro';

interface Props {
  locale: 'nl' | 'fr' | 'en';
  pageKey: string;
  title: string;
  description: string;
}
const { locale, pageKey, title, description } = Astro.props;
const strings = t(locale);
const umamiSrc = import.meta.env.PUBLIC_UMAMI_SRC;
const umamiWebsiteId = import.meta.env.PUBLIC_UMAMI_WEBSITE_ID;
const langAlternates = alternates(/** @type {any} */ (pageKey));
const canonicalPath = localePath(locale, /** @type {any} */ (pageKey));
const canonicalUrl = new URL(canonicalPath, Astro.site).toString();
const defaultUrl = new URL(localePath(DEFAULT_LOCALE, /** @type {any} */ (pageKey)), Astro.site).toString();
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {/* Self-hosted fonts (see global.css): preload the two faces used above
        the fold so the swap happens before first paint. */}
    <link rel="preload" href="/fonts/satoshi-400.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/cabinet-grotesk-800.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonicalUrl} />
    {
      langAlternates.map((alt) => (
        <link rel="alternate" hreflang={alt.locale} href={new URL(alt.href, Astro.site).toString()} />
      ))
    }
    <link rel="alternate" hreflang="x-default" href={defaultUrl} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content={locale} />

    <SchemaOrg locale={locale} />

    {/* Umami reste le choix "sans cookie, hébergé par nous" prévu dans le
        brief : il ne charge que si les deux variables sont renseignées,
        donc rien ne se passe tant que l'instance n'existe pas. Voir
        src/lib/analytics.js. */}
    {
      umamiSrc && umamiWebsiteId && (
        <script defer src={umamiSrc} data-website-id={umamiWebsiteId} data-do-not-track="true"></script>
      )
    }

    {/* Vercel Web Analytics : actif dès ce déploiement, contrairement à
        Umami au-dessus qui attend une instance. Le script se charge sur un
        chemin du même domaine (/_vercel/insights/script.js) — Vercel le
        sert lui-même en périphérie, ce n'est jamais un appel visible vers
        un domaine tiers. Ça ne dispense pas de le déclarer : les données
        de visite (pages vues, provenance) partent bien vers Vercel. Voir
        la politique de confidentialité, mise à jour en même temps. */}
    <Analytics />
  </head>
  <body>
    <a class="skip-link" href="#main">{strings.skipToContent}</a>
    <div style="display:flex;flex-direction:column;min-height:100dvh">
      <Header locale={locale} pageKey={pageKey} />
      <main id="main" style="flex:1">
        <slot />
      </main>
      <Footer locale={locale} pageKey={pageKey} />
    </div>
    <MobileCallBar locale={locale} />

    <script>
      import { trackEvent } from '../lib/analytics.js';
      document.addEventListener('click', (event) => {
        const target = /** @type {HTMLElement} */ (event.target)?.closest('[data-analytics]');
        if (target instanceof HTMLElement) {
          const eventName = target.dataset.analytics;
          if (eventName) trackEvent(/** @type {any} */ (eventName));
        }
      });
    </script>
  </body>
</html>
