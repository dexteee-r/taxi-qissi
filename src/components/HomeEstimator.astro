---
// Le petit bloc d'estimation de la page d'accueil.
//
// C'est un formulaire HTML classique (méthode GET) : il fonctionne même si
// JavaScript est désactivé. C'est pourquoi il garde une liste déroulante de
// villes, là où la page Tarifs a un champ libre. Il envoie son choix à la
// page Tarifs, qui calcule le prix à l'arrivée.
import { t } from '../i18n/dictionary.js';
import { localePath } from '../i18n/routes.js';
import { DESTINATIONS } from '../data/destinations.js';

interface Props {
  locale: 'nl' | 'fr' | 'en';
}
const { locale } = Astro.props;
const s = t(locale);
const ratesUrl = localePath(locale, 'rates');
---

<div class="estimator">
  <div class="only-mobile">
    <h2 class="h-section">{s.estTitle}</h2>
    <p class="sub">{s.estSub}</p>
  </div>

  <div class="sim-card">
    <div class="only-desktop">
      <h2 class="h-card">{s.estTitle}</h2>
      <p class="notice">{s.estSub}</p>
    </div>

    <form method="get" action={ratesUrl}>
      <div class="field">
        <label class="field-label" for="home-from">{s.fFrom}</label>
        <input type="text" id="home-from" name="from" value="Grote Markt, Tienen" />
      </div>
      <div class="field">
        <label class="field-label" for="home-dest">{s.fTo}</label>
        <select id="home-dest" name="dest">
          <option value="">{s.fToPh}</option>
          {DESTINATIONS.map((d) => <option value={d.id}>{d[locale]}</option>)}
        </select>
      </div>
      <button type="submit" class="btn btn-dark qissi-tap estimator-btn">{s.estBtn}</button>
      <p class="notice" style="margin:10px 0 0">{s.estNote}</p>
    </form>
  </div>
</div>

<style>
  .estimator-btn {
    width: 100%;
  }
  @media (min-width: 900px) {
    .estimator-btn {
      width: auto;
      min-height: 56px;
      padding: 0 28px;
    }
  }
</style>
