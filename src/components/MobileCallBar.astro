---
import { BUSINESS } from '../config/business.js';
import { t } from '../i18n/dictionary.js';
import { WHATSAPP_PLAIN_URL } from '../lib/whatsapp.js';

interface Props {
  locale: 'nl' | 'fr' | 'en';
}
const { locale } = Astro.props;
const s = t(locale);
---

<div class="mobile-action-bar">
  <a class="btn btn-call qissi-tap" href={`tel:${BUSINESS.phone}`} data-analytics="call_click">
    <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round"><path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 5.5 5.5L16 12l4 1.5v3a2 2 0 0 1-2.2 2A16 16 0 0 1 4 5.2 2 2 0 0 1 6.5 3Z"/></svg>
    <span style="display:flex;flex-direction:column;gap:1px">
      <span class="call-label">{s.call}</span>
      <span class="call-phone">{BUSINESS.phoneDisplay}</span>
    </span>
  </a>
  <a class="btn btn-whatsapp qissi-tap" href={WHATSAPP_PLAIN_URL} target="_blank" rel="noopener" data-analytics="whatsapp_click">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.5 8.5 0 0 1-12.4 7.6L4 20.5l1.4-4.4A8.5 8.5 0 1 1 21 11.5Z"/></svg>
    <span style="font:700 14px/1 var(--font-display);color:#fff">{s.wa}</span>
  </a>
</div>
