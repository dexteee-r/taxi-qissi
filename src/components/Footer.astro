---
import { BUSINESS } from '../config/business.js';
import { localePath, alternates } from '../i18n/routes.js';
import { t } from '../i18n/dictionary.js';

interface Props {
  locale: 'nl' | 'fr' | 'en';
  pageKey: string;
}
const { locale, pageKey } = Astro.props;
const s = t(locale);
const langAlternates = alternates(/** @type {any} */ (pageKey));

const navItems = [
  { key: 'home', label: s.navHome },
  { key: 'rates', label: s.navPrices },
  { key: 'airport', label: s.navAirport },
  { key: 'services', label: s.navServices },
  { key: 'contact', label: s.navContact },
];
---

<footer class="site-footer">
  <div class="container footer-inner">
    <div class="footer-brand">
      <span class="name">{BUSINESS.commercialName}</span>
      <a href={`tel:${BUSINESS.phone}`}>{BUSINESS.phoneDisplay}</a>
      <span>{BUSINESS.address.street}, {BUSINESS.address.postalCode} {BUSINESS.address.city}</span>
      <span>{BUSINESS.email}</span>
    </div>
    <nav class="footer-nav" aria-label={s.navHome}>
      {navItems.map((item) => <a href={localePath(locale, /** @type {any} */ (item.key))}>{item.label}</a>)}
    </nav>
    <div class="footer-legal">
      <a href={localePath(locale, 'legal')}>{s.navLegal}</a>
      <a href={localePath(locale, 'privacy')}>{s.navPrivacy}</a>
      <div class="footer-langs">
        {
          langAlternates.map((alt) => (
            <a href={alt.href} aria-current={alt.locale === locale ? 'page' : undefined}>
              {alt.locale.toUpperCase()}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</footer>
