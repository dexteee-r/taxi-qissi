---
// La section "Zone desservie" : le champ de recherche de commune et la
// liste des communes. Sur mobile, seules 6 communes sont visibles et le
// reste se déplie. La liste vient de src/config/business.js.
import { t } from '../i18n/dictionary.js';
import { BUSINESS } from '../config/business.js';
import { communeLabel } from '../lib/municipalities.js';

interface Props {
  locale: 'nl' | 'fr' | 'en';
}
const { locale } = Astro.props;
const s = t(locale);
const communes = BUSINESS.servedMunicipalities.map((c) => communeLabel(c, locale));
const communesMain = communes.slice(0, 6);
const communesRest = communes.slice(6);
---

<section class="container section section-divider zone-section" aria-labelledby="zone-title">
  <div class="zone-grid">
    <div>
      <h2 id="zone-title" class="h-section">{s.zoneTitle}</h2>
      <p class="sub" style="max-width:42ch">{s.zoneSub}</p>
      <div class="field" style="max-width:340px">
        <label class="field-label" for="zone-query">{s.zonePh}</label>
        <input type="text" id="zone-query" data-locale={locale} autocomplete="off" placeholder={s.zoneInputPh} />
      </div>

      <p class="zone-hit" id="zone-hit" hidden>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d="M4 12.5l5 5L20 6.5"/></svg>
        <span id="zone-hit-text"></span>
      </p>
      <div class="zone-miss" id="zone-miss" hidden>
        <span id="zone-miss-text"></span>
        <a class="btn btn-call qissi-tap" href={`tel:${BUSINESS.phone}`} data-analytics="call_click">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round"><path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 5.5 5.5L16 12l4 1.5v3a2 2 0 0 1-2.2 2A16 16 0 0 1 4 5.2 2 2 0 0 1 6.5 3Z"/></svg>
          {BUSINESS.phoneDisplay}
        </a>
      </div>
    </div>

    <div>
      <div class="commune-chips">
        {communesMain.map((c) => <span>{c}</span>)}
      </div>
      {/* Ouvert par défaut : sans JavaScript, un visiteur sur ordinateur
          doit quand même voir les 16 communes, pas se retrouver avec un
          bouton masqué et un contenu invisible. Le script ci-dessous
          referme le dépliant sur mobile, où le bouton "Voir plus" reste,
          lui, natif et fonctionnel sans JavaScript. */}
      <details class="commune-more" open>
        <summary>
          {s.zoneAll}
          <span class="chev"></span>
        </summary>
        <div class="commune-more-list">
          {communesRest.map((c) => <div>{c}</div>)}
        </div>
      </details>

      <p class="zone-note">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;margin-top:3px"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.5"/></svg>
        {s.zoneMore}
      </p>
    </div>
  </div>
</section>

<script>
  import { BUSINESS } from '../config/business.js';
  import { dictionary } from '../i18n/dictionary.js';
  import { communeLabel, findCommune, normalize } from '../lib/municipalities.js';

  // Sur ordinateur, les 16 communes du dépliant doivent être visibles
  // d'emblée (le bouton "Voir plus" est masqué en CSS à partir de 900px).
  // Un <details> fermé ne montre son contenu QUE si l'attribut `open` est
  // réellement posé — aucune règle CSS sur son contenu ne peut contourner
  // ça, même avec !important (vérifié : forcer .open = true en JS fait
  // passer sa hauteur de 0 à sa vraie valeur, alors que forcer `display`
  // ou `content-visibility` sur son contenu ne change rien). D'où ce petit
  // script, plutôt qu'une solution "tout CSS" qui semblait possible mais
  // ne l'est pas pour cet élément précis.
  const depliant = document.querySelector('.commune-more');
  if (depliant) {
    const estOrdinateur = window.matchMedia('(min-width: 900px)');
    const synchroniser = () => {
      depliant.open = estOrdinateur.matches;
    };
    synchroniser();
    estOrdinateur.addEventListener('change', synchroniser);
  }

  const input = document.getElementById('zone-query');
  const hit = document.getElementById('zone-hit');
  const miss = document.getElementById('zone-miss');

  if (input && hit && miss) {
    const locale = input.getAttribute('data-locale') ?? 'nl';
    const s = dictionary[locale];

    input.addEventListener('input', () => {
      if (normalize(input.value).length < 3) {
        hit.hidden = true;
        miss.hidden = true;
        return;
      }
      const match = findCommune(BUSINESS.servedMunicipalities, input.value);

      if (match) {
        document.getElementById('zone-hit-text').textContent = `${s.zoneYes}${communeLabel(match, locale)}.`;
        hit.hidden = false;
        miss.hidden = true;
      } else {
        document.getElementById('zone-miss-text').textContent = `« ${input.value.trim()} »${s.zoneNo}`;
        miss.hidden = false;
        hit.hidden = true;
      }
    });
  }
</script>
