---
// Section de la page Aéroport qui s'adresse aux clients de Jodoigne (demande
// du client, 2026-11-14). Sans prix : le forfait affiché plus haut est celui
// d'un départ de Tienen, et celui de Jodoigne reste à communiquer par le
// client — le texte renvoie donc vers l'appel ou WhatsApp, et les deux
// boutons sont là pour que le visiteur n'ait pas à chercher la page Contact.
import { BUSINESS } from '../config/business.js';
import { t } from '../i18n/dictionary.js';
import { buildWhatsAppUrl } from '../lib/whatsapp.js';

interface Props {
  locale: 'nl' | 'fr' | 'en';
}
const { locale } = Astro.props;
const s = t(locale);
// Le message annonce déjà le départ de Jodoigne : le chauffeur n'a pas à le demander.
const waUrl = buildWhatsAppUrl(s.jodWaMessage);
---

<section class="airport-from" aria-labelledby="airport-from-title">
  <h2 id="airport-from-title" class="h-section">{s.jodTitle}</h2>
  <p class="sub">{s.jodText}</p>
  <div class="airport-from-cta">
    <a class="btn btn-call qissi-tap" href={`tel:${BUSINESS.phone}`} data-analytics="call_click">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 5.5 5.5L16 12l4 1.5v3a2 2 0 0 1-2.2 2A16 16 0 0 1 4 5.2 2 2 0 0 1 6.5 3Z"/></svg>
      <span style="font:700 17px/1 var(--font-display)">{BUSINESS.phoneDisplay}</span>
    </a>
    <a class="btn btn-whatsapp qissi-tap" href={waUrl} target="_blank" rel="noopener" data-analytics="whatsapp_click">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 11.5a8.5 8.5 0 0 1-12.4 7.6L4 20.5l1.4-4.4A8.5 8.5 0 1 1 21 11.5Z"/></svg>
      {s.wa}
    </a>
  </div>
</section>
