---
import { BUSINESS, FARE } from '../config/business.js';
import schemaDescription from '../content/common/schema-description.json';

interface Props {
  locale: 'nl' | 'fr' | 'en';
}
const { locale } = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, '') ?? '';

// Les données structurées lues par Google (elles ne s'affichent pas).
//
// PIEGE : priceRange et openingHoursSpecification ne sont PAS valides sur
// TaxiService, seulement sur une entreprise locale. Ils sont donc placés
// dans `provider`. Vérifié sur validator.schema.org : 0 erreur.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'TaxiService',
  name: BUSINESS.commercialName,
  description: schemaDescription[locale],
  provider: {
    '@type': 'LocalBusiness',
    '@id': `${siteUrl}/#business`,
    name: BUSINESS.commercialName,
    legalName: BUSINESS.legalName,
    vatID: BUSINESS.vatNumber,
    url: siteUrl || undefined,
    address: {
      '@type': 'PostalAddress',
      streetAddress: BUSINESS.address.street,
      postalCode: BUSINESS.address.postalCode,
      addressLocality: BUSINESS.address.city,
      addressCountry: BUSINESS.address.country,
    },
    geo: {
      '@type': 'GeoCoordinates',
      latitude: BUSINESS.geoMidpoint.latitude,
      longitude: BUSINESS.geoMidpoint.longitude,
    },
    telephone: BUSINESS.phone,
    // Relie le site à la fiche Google Business Profile (même entreprise,
    // même lieu) : c'est ce que lisent Google et les moteurs génératifs pour
    // rattacher les avis et la fiche à ce site.
    hasMap: BUSINESS.googleMapsUrl,
    sameAs: [BUSINESS.googleMapsUrl],
    email: BUSINESS.email,
    priceRange: `€${FARE.baseFare.toFixed(2)} + €${FARE.perKmRate.toFixed(2)}/km`,
    openingHoursSpecification: {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday'],
      opens: '00:00',
      closes: '23:59',
    },
  },
  areaServed: {
    '@type': 'GeoCircle',
    geoMidpoint: {
      '@type': 'GeoCoordinates',
      latitude: BUSINESS.geoMidpoint.latitude,
      longitude: BUSINESS.geoMidpoint.longitude,
    },
    geoRadius: String(BUSINESS.serviceRadiusMeters),
  },
};
---

<script type="application/ld+json" set:html={JSON.stringify(schema)} />
