---
import { t } from '../i18n/dictionary.js';

interface Props {
  locale: 'nl' | 'fr' | 'en';
}
const { locale } = Astro.props;
const s = t(locale);
---

<div class="rates-list">
  <div class="rates-row">
    <span class="label">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M6 21V4h11l-1.5 4L17 12H6"/></svg>
      {s.pPickup}
    </span>
    <span class="amount">4 €</span>
  </div>
  <div class="rates-row">
    <span class="label">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M4 18h5a3 3 0 0 0 0-6H9a3 3 0 0 1 0-6h6"/><path d="M17 3l3 3-3 3"/></svg>
      {s.pPerKm}
    </span>
    <span class="amount">3 €</span>
  </div>
  <div class="rates-row">
    <span class="label">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7.5V12l3.5 2"/></svg>
      {s.pWait}
    </span>
    <span class="amount">36 €/h</span>
  </div>
  <div class="rates-row night">
    <span class="label">
      <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent-hover)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.5A8.5 8.5 0 0 1 9.5 4a8.5 8.5 0 1 0 10.5 10.5Z"/></svg>
      <span class="rates-night-label">
        <span class="main">{s.pNight}</span>
        <span class="hours">{s.pNightSub}</span>
      </span>
    </span>
    <span class="amount">+ 3 €</span>
  </div>
</div>
