---
// La liste courte des services, sur la page d'accueil.
// Le contenu vient de src/data/services.js.
interface Props {
  services: Array<{ title: string; desc: string; icon: string }>;
}
const { services } = Astro.props;
---

<div class="services-list">
  {
    services.map((svc) => (
      <div class="service-cell">
        <span class="service-title">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" style="flex:none"><path d={svc.icon} /></svg>
          {svc.title}
        </span>
        <span class="service-desc">{svc.desc}</span>
      </div>
    ))
  }
</div>
