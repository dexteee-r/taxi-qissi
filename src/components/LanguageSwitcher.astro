---
import { alternates, LOCALE_NAMES } from '../i18n/routes.js';
import { t } from '../i18n/dictionary.js';

interface Props {
  locale: 'nl' | 'fr' | 'en';
  pageKey: string;
}
const { locale, pageKey } = Astro.props;
const links = alternates(/** @type {any} */ (pageKey));
const label = t(locale).languageSwitcher.label;
---

<nav class="lang-switcher" aria-label={label}>
  <ul>
    {
      links.map((link) => (
        <li>
          <a href={link.href} aria-current={link.locale === locale ? 'page' : undefined}>
            {LOCALE_NAMES[link.locale]}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<style>
  .lang-switcher ul {
    display: flex;
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .lang-switcher a {
    text-decoration: none;
    color: var(--color-text-muted);
    padding: 0.4rem 0.2rem;
    min-height: 48px;
    display: inline-flex;
    align-items: center;
  }
  .lang-switcher a[aria-current='page'] {
    color: var(--color-text);
    font-weight: 700;
    text-decoration: underline;
  }
</style>
