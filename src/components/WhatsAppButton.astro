---
import { t } from '../i18n/dictionary.js';
import { WHATSAPP_PLAIN_URL } from '../lib/whatsapp.js';

interface Props {
  locale: 'nl' | 'fr' | 'en';
}
const { locale } = Astro.props;
const s = t(locale);
---

<a class="btn btn-whatsapp qissi-tap" href={WHATSAPP_PLAIN_URL} target="_blank" rel="noopener" data-analytics="whatsapp_click">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.5 8.5 0 0 1-12.4 7.6L4 20.5l1.4-4.4A8.5 8.5 0 1 1 21 11.5Z"/></svg>
  {s.wa}
</a>
