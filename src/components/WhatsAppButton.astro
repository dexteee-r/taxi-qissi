---
import { BUSINESS } from '../config/business.js';
import { t } from '../i18n/dictionary.js';

interface Props {
  locale: 'nl' | 'fr' | 'en';
}
const { locale } = Astro.props;
const strings = t(locale).common;
const isConfigured = BUSINESS.whatsapp && BUSINESS.whatsapp !== '[TO_BE_CONFIRMED]';
const href = isConfigured
  ? `https://wa.me/${BUSINESS.whatsapp}?text=${encodeURIComponent(strings.whatsappGreeting)}`
  : undefined;
---

{
  isConfigured ? (
    <a class="btn btn-whatsapp" href={href} target="_blank" rel="noopener" data-analytics="whatsapp_click">
      {strings.whatsapp}
    </a>
  ) : (
    <span class="btn btn-whatsapp placeholder-marker" aria-disabled="true" title={strings.whatsappUnavailable}>
      {strings.whatsapp} ⚠
    </span>
  )
}
