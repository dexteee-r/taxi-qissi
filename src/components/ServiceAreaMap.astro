---
// La carte de la page Contact : le rayon d'environ 20 km desservi.
//
// Contrairement à celle du simulateur, elle n'est pas derrière un clic. Elle
// se charge donc quand elle entre dans l'écran, pas au chargement de la page.
// Le dessin en pointillés reste dans le HTML : c'est ce qu'on voit sans
// JavaScript, ou si la carte échoue.
import { BUSINESS } from '../config/business.js';
import { t } from '../i18n/dictionary.js';

interface Props {
  locale: 'nl' | 'fr' | 'en';
}
const { locale } = Astro.props;
const s = t(locale);
const radiusKm = Math.round(BUSINESS.serviceRadiusMeters / 1000);
---

<div
  class="contact-media"
  id="service-area-map"
  data-lat={BUSINESS.routingOrigin.lat}
  data-lon={BUSINESS.routingOrigin.lon}
  data-radius={BUSINESS.serviceRadiusMeters}
  data-label={`${s.zoneTitle} — ${radiusKm} km`}
>
  <svg viewBox="0 0 340 150" width="100%" height="100%" style="display:block" aria-hidden="true">
    <circle cx="170" cy="75" r="58" fill="var(--color-accent)" fill-opacity=".08" stroke="var(--color-accent)" stroke-width="2" stroke-dasharray="5 5"></circle>
    <circle cx="170" cy="75" r="8" fill="var(--color-accent)"></circle>
  </svg>
</div>

<script>
  const conteneur = document.getElementById('service-area-map');

  // Remplace le dessin par la vraie carte. Si quoi que ce soit échoue, le
  // dessin reste (ou revient) : on ne laisse jamais un cadre vide.
  async function afficherLaCarte() {
    if (!conteneur) return;
    const dessin = conteneur.querySelector('svg');
    try {
      const { showServiceArea } = await import('../lib/route-map.js');
      // On n'enlève le dessin qu'une fois Leaflet prêt à prendre le relais.
      dessin?.remove();
      const affichee = await showServiceArea(
        conteneur,
        { lat: Number(conteneur.dataset.lat), lon: Number(conteneur.dataset.lon) },
        Number(conteneur.dataset.radius),
        conteneur.dataset.label ?? ''
      );
      if (!affichee && dessin) conteneur.appendChild(dessin);
    } catch {
      if (dessin && !conteneur.contains(dessin)) conteneur.appendChild(dessin);
    }
  }

  // On attend que la carte approche de l'écran avant de charger quoi que ce
  // soit : les autres pages ne demandent ainsi aucune tuile.
  if (conteneur) {
    const observateur = new IntersectionObserver(
      (entrees) => {
        if (entrees.some((entree) => entree.isIntersecting)) {
          observateur.disconnect();
          afficherLaCarte();
        }
      },
      { rootMargin: '200px' }
    );
    observateur.observe(conteneur);
  }
</script>
