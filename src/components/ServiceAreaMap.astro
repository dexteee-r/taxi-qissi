---
// Contact page map: the ~20 km radius the business serves.
//
// Unlike the simulator's map, nothing here is behind a click, so it is
// loaded when it scrolls into view rather than on page load (brief §7: the
// map must never block the initial render). The prototype's dashed-circle
// illustration stays in the markup as the fallback — it is what a visitor
// sees without JavaScript, or if Leaflet or the tiles fail.
import { BUSINESS } from '../config/business.js';
import { t } from '../i18n/dictionary.js';

interface Props {
  locale: 'nl' | 'fr' | 'en';
}
const { locale } = Astro.props;
const s = t(locale);
const radiusKm = Math.round(BUSINESS.serviceRadiusMeters / 1000);
---

<div
  class="contact-media"
  id="service-area-map"
  data-lat={BUSINESS.routingOrigin.lat}
  data-lon={BUSINESS.routingOrigin.lon}
  data-radius={BUSINESS.serviceRadiusMeters}
  data-label={`${s.zoneTitle} — ${radiusKm} km`}
>
  <svg viewBox="0 0 340 150" width="100%" height="100%" style="display:block" aria-hidden="true">
    <circle cx="170" cy="75" r="58" fill="var(--color-accent)" fill-opacity=".08" stroke="var(--color-accent)" stroke-width="2" stroke-dasharray="5 5"></circle>
    <circle cx="170" cy="75" r="8" fill="var(--color-accent)"></circle>
  </svg>
</div>

<script>
  const container = document.getElementById('service-area-map');
  if (container) {
    const mount = async () => {
      try {
        const { showServiceArea } = await import('../lib/route-map.js');
        const centre = {
          lat: Number(container.dataset.lat),
          lon: Number(container.dataset.lon),
        };
        // Clear the placeholder only once Leaflet is ready to take over, so a
        // failed import leaves the illustration in place.
        const svg = container.querySelector('svg');
        svg?.remove();
        const shown = await showServiceArea(
          container,
          centre,
          Number(container.dataset.radius),
          container.dataset.label ?? ''
        );
        if (!shown && svg) container.appendChild(svg);
      } catch {
        /* the illustration stays */
      }
    };

    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          if (entries.some((entry) => entry.isIntersecting)) {
            observer.disconnect();
            mount();
          }
        },
        { rootMargin: '200px' }
      );
      observer.observe(container);
    } else {
      mount();
    }
  }
</script>
