---
// Price simulator — hybrid architecture per the user's direction (2026-09-04):
// a dropdown of preset destinations (from the validated prototype, fixed
// km/min, airports marked "tbc") for the common case, plus a live address
// lookup via OpenRouteService for "other address" — reusing the geocoding
// module built for the CDC's original free-text-address design. Everything
// still runs entirely client-side (brief §1.1).
//
// Layout follows both prototype artboards: heading outside the card on
// mobile / inside on desktop, sticky compute button on mobile, and a
// receipt whose action order differs per breakpoint (see global.css).
import { t } from '../i18n/dictionary.js';
import { DESTINATIONS } from '../data/destinations.js';
import { BUSINESS } from '../config/business.js';

interface Props {
  locale: 'nl' | 'fr' | 'en';
}
const { locale } = Astro.props;
const s = t(locale);
---

<section class="simulator" data-locale={locale} aria-labelledby="sim-title">
  <div class="only-mobile">
    <h2 id="sim-title" class="h-section">{s.simTitle}</h2>
    <p class="sub">{s.simSub}</p>
  </div>

  <div class="sim-card">
    <div class="only-desktop">
      <h2 class="h-card">{s.simTitle}</h2>
      <p class="notice">{s.simSub}</p>
    </div>

    <form id="sim-form" novalidate>
      {/* The pickup address is a combobox like the destination one: it is
          what the route is measured from, so it needs a real coordinate,
          not just a label for the WhatsApp message. Pre-filled with the
          town's main square, whose coordinate we already know — the common
          case therefore still costs zero API calls. */}
      <div class="field autocomplete-field">
        <label class="field-label" for="from">{s.fFrom}</label>
        <input
          type="text"
          id="from"
          name="from"
          value={BUSINESS.defaultPickup.label}
          role="combobox"
          aria-expanded="false"
          aria-autocomplete="list"
          aria-controls="from-listbox"
          autocomplete="off"
          maxlength="120"
          placeholder={s.fFromPh}
        />
        <ul id="from-listbox" role="listbox" class="suggestions" hidden></ul>
      </div>

      <div class="field">
        <label class="field-label" for="dest">{s.fTo}</label>
        <select id="dest" name="dest">
          <option value="">{s.fToPh}</option>
          {DESTINATIONS.map((d) => <option value={d.id}>{d[locale]}</option>)}
        </select>
      </div>

      <div class="field autocomplete-field" id="other-address-wrap" hidden>
        <label class="field-label" for="other-address">{s.fOtherAddress}</label>
        <input
          type="text"
          id="other-address"
          role="combobox"
          aria-expanded="false"
          aria-autocomplete="list"
          aria-controls="other-address-listbox"
          autocomplete="off"
          maxlength="120"
          placeholder={s.fOtherAddressPh}
        />
        <ul id="other-address-listbox" role="listbox" class="suggestions" hidden></ul>
      </div>

      <div id="state-error" class="error-box" hidden>
        <span class="error-msg">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--color-danger)" stroke-width="2" stroke-linecap="round" style="flex:none;margin-top:2px"><circle cx="12" cy="12" r="9"/><path d="M12 8v4.5M12 16v.01"/></svg>
          <span id="error-text">{s.errBody}</span>
        </span>
        <a class="btn btn-call qissi-tap" href={`tel:${BUSINESS.phone}`} data-analytics="call_click">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" style="flex:none"><path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 5.5 5.5L16 12l4 1.5v3a2 2 0 0 1-2.2 2A16 16 0 0 1 4 5.2 2 2 0 0 1 6.5 3Z"/></svg>
          {BUSINESS.phoneDisplay}
        </a>
      </div>

      <div class="field-row">
        <div class="field">
          <label class="field-label" for="date">{s.fDate}</label>
          <input type="date" id="date" name="date" />
        </div>
        <div class="field">
          <label class="field-label" for="time">{s.fTime}</label>
          <input type="time" id="time" name="time" />
        </div>
      </div>

      <div class="field-row">
        <div class="field">
          <span class="field-label" id="pax-label">{s.fPax}</span>
          <div class="counter">
            <span class="counter-value" id="pax-value" aria-live="polite" aria-labelledby="pax-label">2</span>
            <span style="display:flex;gap:2px">
              <button class="qissi-tap" type="button" id="pax-down" aria-label="−">−</button>
              <button class="qissi-tap" type="button" id="pax-up" aria-label="+">+</button>
            </span>
          </div>
        </div>
        <div class="field">
          <span class="field-label" id="bags-label">{s.fBags}</span>
          <div class="counter">
            <span class="counter-value" id="bags-value" aria-live="polite" aria-labelledby="bags-label">1</span>
            <span style="display:flex;gap:2px">
              <button class="qissi-tap" type="button" id="bags-down" aria-label="−">−</button>
              <button class="qissi-tap" type="button" id="bags-up" aria-label="+">+</button>
            </span>
          </div>
        </div>
      </div>

      <div class="field">
        <label class="field-label" for="name">{s.fName}</label>
        <input type="text" id="name" name="name" placeholder={s.fNamePh} />
      </div>

      <div class="field">
        <label class="field-label" for="note">{s.fNote}</label>
        <textarea id="note" name="note" rows="2" placeholder={s.fNotePh}></textarea>
      </div>

      <p class="notice" style="margin:0">{s.noPhone}</p>

      <div id="state-loading" class="sim-loading" hidden>
        <div class="bar-track"><div class="bar-fill"></div></div>
        <span id="loading-text">{s.loading}</span>
      </div>

      <div id="state-result" class="qissi-receipt" hidden>
        {/* Filled in on demand once an estimate is computed — see the
            lazy import in the script below. Hidden entirely if the map
            cannot load, so it never blocks the price or the call button. */}
        <div class="receipt-map" id="route-map" hidden></div>

        <div style="display:flex;flex-direction:column;gap:3px">
          <span class="receipt-route" id="route-label"></span>
          <span class="receipt-distance" id="distance-label"></span>
        </div>

        <div class="receipt-price-row">
          <span style="display:flex;flex-direction:column;gap:5px;padding-bottom:4px">
            <span style="font:600 13.5px/1.3 var(--font-body)">{s.resTitle}</span>
            <span class="receipt-indicative" id="indicative-badge">{s.indicative}</span>
          </span>
          <span class="receipt-price" id="price-label"></span>
        </div>

        <div class="receipt-breakdown" id="breakdown">
          <div><span>{s.bPickup}</span><span id="line-pickup"></span></div>
          <div><span id="line-km-label"></span><span id="line-km-cost"></span></div>
          <div class="night" id="line-night" hidden><span>{s.bNight}</span><span>+ 3 €</span></div>
        </div>

        <div id="tbc-note" style="display:flex;flex-direction:column;gap:10px;align-items:flex-start" hidden>
          <span style="display:flex;gap:8px;font:400 13px/1.5 var(--font-body);color:var(--color-text-muted)">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;margin-top:2px"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.5"/></svg>
            {s.tbcNote}
          </span>
          <a class="btn btn-call qissi-tap" href={`tel:${BUSINESS.phone}`} data-analytics="call_click">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" style="flex:none"><path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 5.5 5.5L16 12l4 1.5v3a2 2 0 0 1-2.2 2A16 16 0 0 1 4 5.2 2 2 0 0 1 6.5 3Z"/></svg>
            {BUSINESS.phoneDisplay}
          </a>
        </div>

        {/* Shown when the live lookup lands further away than anything the
            dropdown offers: the price still appears, but a trip of that
            length is worth agreeing on the phone. */}
        <div id="long-distance-note" style="display:flex;flex-direction:column;gap:10px;align-items:flex-start" hidden>
          <span style="display:flex;gap:8px;font:400 13px/1.5 var(--font-body);color:var(--color-text-muted)">
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="var(--color-accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="flex:none;margin-top:2px"><circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.5"/></svg>
            {s.longDistance}
          </span>
          <a class="btn btn-call qissi-tap" href={`tel:${BUSINESS.phone}`} data-analytics="call_click">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" style="flex:none"><path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 5.5 5.5L16 12l4 1.5v3a2 2 0 0 1-2.2 2A16 16 0 0 1 4 5.2 2 2 0 0 1 6.5 3Z"/></svg>
            {BUSINESS.phoneDisplay}
          </a>
        </div>

        <div class="receipt-actions">
          <a id="whatsapp-send" class="btn btn-whatsapp qissi-tap receipt-wa" href="#" data-analytics="whatsapp_send">
            <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.5 8.5 0 0 1-12.4 7.6L4 20.5l1.4-4.4A8.5 8.5 0 1 1 21 11.5Z"/></svg>
            {s.waBtn}
          </a>
          <button type="button" class="btn btn-outline qissi-tap receipt-reset" id="recompute-btn">{s.recompute}</button>
        </div>

        <p class="notice receipt-disclosure" style="margin:0">{s.whatsappDisclosure}</p>

        <dl class="receipt-msg">
          <dt>{s.msgTitle}</dt>
          <dd id="wa-message-preview"></dd>
        </dl>
      </div>

      <div class="compute-wrap">
        <button type="submit" class="btn btn-dark qissi-tap" id="compute-btn" data-analytics="simulator_open">{s.compute}</button>
      </div>
    </form>
  </div>
</section>

<style>
  .autocomplete-field {
    position: relative;
  }
  .suggestions {
    position: absolute;
    z-index: 20;
    top: 100%;
    left: 0;
    right: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    background: #fff;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
    max-height: 14rem;
    overflow-y: auto;
    box-shadow: 0 12px 24px -12px rgba(9, 9, 11, 0.18);
  }
  .suggestions li {
    padding: 0.6rem 0.75rem;
    cursor: pointer;
    min-height: 48px;
    display: flex;
    align-items: center;
    font-size: 14px;
  }
  /* "Searching…" / "No address found" — a row that reports, not a choice. */
  .suggestions li.suggestion-status {
    color: var(--color-text-muted);
    font-style: italic;
    cursor: default;
    background: transparent;
  }
  .suggestions li[aria-selected='true'],
  .suggestions li:hover {
    background: var(--color-accent-tint);
  }
  .receipt-disclosure {
    order: 1;
  }
  @media (min-width: 900px) {
    .receipt-disclosure {
      order: 1;
    }
  }
</style>

<script>
  import { autocompleteAddress, routeDistance, MapServiceError } from '../lib/geocoding.js';
  import { estimateFare } from '../lib/fare.js';
  import { buildWhatsAppMessage, buildWhatsAppUrl } from '../lib/whatsapp.js';
  import { formatEuro, formatKm } from '../lib/format.js';
  import { t } from '../i18n/dictionary.js';
  import { DESTINATIONS, FURTHEST_PRESET_KM } from '../data/destinations.js';
  import { BUSINESS, FARE } from '../config/business.js';
  import { trackEvent } from '../lib/analytics.js';

  const section = document.querySelector('.simulator');
  if (section) {
    const locale = /** @type {'nl'|'fr'|'en'} */ (section.getAttribute('data-locale') ?? 'nl');
    const s = t(locale);
    const form = /** @type {HTMLFormElement} */ (document.getElementById('sim-form'));
    const destSelect = /** @type {HTMLSelectElement} */ (document.getElementById('dest'));
    const fromInput = /** @type {HTMLInputElement} */ (document.getElementById('from'));
    const fromListbox = /** @type {HTMLUListElement} */ (document.getElementById('from-listbox'));
    const otherWrap = document.getElementById('other-address-wrap');
    const otherInput = /** @type {HTMLInputElement} */ (document.getElementById('other-address'));
    const otherListbox = /** @type {HTMLUListElement} */ (document.getElementById('other-address-listbox'));

    const errorEl = document.getElementById('state-error');
    const loadingEl = document.getElementById('state-loading');
    const resultEl = document.getElementById('state-result');
    const computeWrap = document.querySelector('.compute-wrap');

    function showState(name) {
      errorEl.hidden = name !== 'error';
      loadingEl.hidden = name !== 'loading';
      resultEl.hidden = name !== 'result';
      computeWrap.hidden = name === 'loading' || name === 'result';
    }

    // --- pax / bags counters ------------------------------------------
    function setupCounter(prefix, min, max, initial) {
      const valueEl = document.getElementById(`${prefix}-value`);
      let value = initial;
      document.getElementById(`${prefix}-down`).addEventListener('click', () => {
        value = Math.max(min, value - 1);
        valueEl.textContent = String(value);
      });
      document.getElementById(`${prefix}-up`).addEventListener('click', () => {
        value = Math.min(max, value + 1);
        valueEl.textContent = String(value);
      });
      return () => value;
    }
    const getPax = setupCounter('pax', 1, 8, 2);
    const getBags = setupCounter('bags', 0, 8, 1);

    // --- accessible address combobox -----------------------------------
    // Both address fields behave identically, so they share one
    // implementation. A field is "resolved" only when its text corresponds
    // to a coordinate the visitor actually picked: typing an address is not
    // the same as choosing one, and the route cannot be measured from a
    // string. Editing the text un-resolves the field again.
    function createAddressField(input, listbox, idPrefix) {
      let items = [];
      let activeIndex = -1;
      let debounceTimer;
      let resolved = null;

      function closeList() {
        listbox.hidden = true;
        input.setAttribute('aria-expanded', 'false');
        input.removeAttribute('aria-activedescendant');
        activeIndex = -1;
      }

      // A single non-selectable row: "searching…" or "no address found".
      // Without it the field just stays silent, which reads as "nothing
      // happened" rather than "there is no such address".
      function renderStatus(text) {
        listbox.innerHTML = '';
        const li = document.createElement('li');
        li.className = 'suggestion-status';
        li.setAttribute('role', 'status');
        li.textContent = text;
        listbox.appendChild(li);
        listbox.hidden = false;
        input.setAttribute('aria-expanded', 'false');
        input.removeAttribute('aria-activedescendant');
      }

      function renderList() {
        listbox.innerHTML = '';
        items.forEach((item, index) => {
          const li = document.createElement('li');
          li.role = 'option';
          li.id = `${idPrefix}-opt-${index}`;
          li.textContent = item.label;
          li.setAttribute('aria-selected', String(index === activeIndex));
          li.addEventListener('mousedown', (e) => {
            e.preventDefault();
            selectItem(index);
          });
          listbox.appendChild(li);
        });
        listbox.hidden = items.length === 0;
        input.setAttribute('aria-expanded', String(items.length > 0));
        if (activeIndex >= 0) {
          input.setAttribute('aria-activedescendant', `${idPrefix}-opt-${activeIndex}`);
        } else {
          input.removeAttribute('aria-activedescendant');
        }
      }

      function selectItem(index) {
        const item = items[index];
        if (!item) return;
        input.value = item.label;
        resolved = { lon: item.lon, lat: item.lat, label: item.label };
        closeList();
        showState(null);
      }

      async function lookup(query) {
        renderStatus(s.acSearching);
        try {
          items = await autocompleteAddress(query, BUSINESS.routingOrigin);
          activeIndex = -1;
          if (items.length === 0) renderStatus(s.acNoResult);
          else renderList();
        } catch {
          items = [];
          closeList();
        }
      }

      input.addEventListener('input', () => {
        resolved = null;
        clearTimeout(debounceTimer);
        const query = input.value;
        if (query.trim().length < 3) {
          items = [];
          closeList();
          return;
        }
        // 500 ms rather than 300: the API key is public by design, so its
        // daily quota protects real visitors only as long as we spend it
        // sparingly. Waiting for a real pause in typing roughly halves the
        // request count.
        debounceTimer = setTimeout(() => lookup(query), 500);
      });

      input.addEventListener('keydown', (e) => {
        if (listbox.hidden) return;
        if (e.key === 'ArrowDown') {
          e.preventDefault();
          activeIndex = Math.min(activeIndex + 1, items.length - 1);
          renderList();
        } else if (e.key === 'ArrowUp') {
          e.preventDefault();
          activeIndex = Math.max(activeIndex - 1, 0);
          renderList();
        } else if (e.key === 'Enter') {
          // Enter on an open list means "take this one", never "submit the
          // form": submitting would fail on the very address being offered.
          if (items.length > 0) {
            e.preventDefault();
            selectItem(activeIndex >= 0 ? activeIndex : 0);
          }
        } else if (e.key === 'Escape') {
          closeList();
        }
      });

      input.addEventListener('blur', () => setTimeout(closeList, 100));

      return {
        get value() {
          return resolved;
        },
        set(coord) {
          resolved = coord;
          if (coord) input.value = coord.label;
        },
        clear() {
          resolved = null;
        },
        // Used when the visitor submits with an address they typed but never
        // picked: open the list on it rather than only complaining.
        prompt() {
          input.focus();
          const query = input.value;
          if (query.trim().length >= 3) lookup(query);
        },
      };
    }

    const fromField = createAddressField(fromInput, fromListbox, 'from');
    const otherField = createAddressField(otherInput, otherListbox, 'other-address');
    // The pre-filled pickup address is already resolved: its coordinate is
    // the one every stored distance was measured from.
    fromField.set({ ...BUSINESS.defaultPickup });

    // --- destination select: reveal "other address" field --------------
    destSelect.addEventListener('change', () => {
      const isOther = destSelect.value === 'other';
      otherWrap.hidden = !isOther;
      showState(null);
      // The chosen address is deliberately kept: leaving "other" and coming
      // back used to leave the field showing an address the form no longer
      // considered chosen, and the site then claimed it could not find it.
      if (isOther) otherInput.focus();
    });

    // --- compute --------------------------------------------------------
    function fail(message, field) {
      document.getElementById('error-text').textContent = message;
      showState('error');
      if (field) field.prompt();
    }

    // Which message an OpenRouteService failure deserves. "Address not found"
    // is only true for `not_found`: an exhausted quota or a network outage
    // has nothing to do with the address, and telling every visitor their
    // address is wrong would hide the real problem from us as well.
    function serviceMessage(err) {
      return err instanceof MapServiceError && err.kind === 'not_found' ? s.lookupError : s.errService;
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const destId = destSelect.value;

      if (!fromInput.value.trim()) return fail(s.errNoFrom, fromField);
      if (!fromField.value) return fail(s.errPickAddress, fromField);
      if (!destId) return fail(s.errBody);
      if (destId === 'other' && !otherField.value) return fail(s.errPickAddress, otherField);

      const time = /** @type {HTMLInputElement} */ (document.getElementById('time')).value;
      const hour = time ? parseInt(time.slice(0, 2), 10) : new Date().getHours();

      const origin = fromField.value;
      const dest = DESTINATIONS.find((d) => d.id === destId);
      // The stored distances were all measured from the pre-filled pickup
      // point, so they are only usable while the visitor keeps it. Change the
      // pickup address and the trip has to be measured for real — otherwise
      // someone starting three towns away is quoted a Tienen price.
      const fromDefault =
        origin.lat === BUSINESS.defaultPickup.lat && origin.lon === BUSINESS.defaultPickup.lon;
      const needsLiveRoute = destId === 'other' || !fromDefault;

      let km, min, destLabel, isTbc;
      // Route shape for the map, as [lat, lon] pairs. The live lookup returns
      // them directly; preset destinations decode theirs from the generated
      // data file instead.
      let livePoints = null;

      if (needsLiveRoute) {
        const target = destId === 'other' ? otherField.value : { lat: dest.lat, lon: dest.lon };
        showState('loading');
        document.getElementById('loading-text').textContent =
          destId === 'other' ? s.lookupLoading : s.loading;
        try {
          const route = await routeDistance(origin, target);
          km = Math.round(route.km * 10) / 10;
          min = route.min;
          destLabel = destId === 'other' ? otherField.value.label : dest[locale];
          isTbc = destId === 'other' ? false : !!dest.tbc;
          livePoints = route.points;
        } catch (err) {
          fail(serviceMessage(err));
          if (!(err instanceof MapServiceError)) console.error(err);
          return;
        }
      } else {
        showState('loading');
        document.getElementById('loading-text').textContent = s.loading;
        await new Promise((r) => setTimeout(r, 700));
        km = dest.km;
        min = dest.min;
        destLabel = dest[locale];
        isTbc = !!dest.tbc;
      }

      const fare = estimateFare(km, ((hour % 24) + 24) % 24);
      // The confirmed label, not the raw field: what is priced and what the
      // driver reads in the WhatsApp message must be the same address.
      const fromVal = origin.label;
      const dateVal = /** @type {HTMLInputElement} */ (document.getElementById('date')).value;
      const nameVal = /** @type {HTMLInputElement} */ (document.getElementById('name')).value;
      const noteVal = /** @type {HTMLTextAreaElement} */ (document.getElementById('note')).value;
      const pax = getPax();
      const bags = getBags();

      document.getElementById('route-label').textContent = `${fromVal} → ${destLabel}`;
      document.getElementById('distance-label').textContent = isTbc
        ? s.tbcDist
        : `${formatKm(km, locale)} · ~${min} min`;

      const priceEl = document.getElementById('price-label');
      priceEl.textContent = isTbc ? s.tbcPrice : formatEuro(fare.total, locale);
      priceEl.classList.toggle('is-tbc', isTbc);

      document.getElementById('indicative-badge').hidden = isTbc;
      document.getElementById('breakdown').hidden = isTbc;
      document.getElementById('line-pickup').textContent = formatEuro(fare.breakdown.base, locale);
      document.getElementById('line-km-label').textContent =
        `${formatKm(km, locale)} × ${formatEuro(FARE.perKmRate, locale)}`;
      document.getElementById('line-km-cost').textContent = formatEuro(fare.breakdown.distance, locale);
      document.getElementById('line-night').hidden = !fare.isNight;
      document.getElementById('tbc-note').hidden = !isTbc;
      // Further than anything the dropdown offers: still priced, but worth
      // agreeing on the phone. Not shown for the preset destinations
      // themselves — the client chose to advertise those.
      document.getElementById('long-distance-note').hidden = !(
        !isTbc && km > FURTHEST_PRESET_KM
      );

      const message = buildWhatsAppMessage({
        locale,
        form: { from: fromVal, destLabel, date: dateVal, time, pax, bags, name: nameVal, note: noteVal },
        fare: { total: fare.total, isTbc },
      });
      document.getElementById('wa-message-preview').textContent = `« ${message} »`;
      /** @type {HTMLAnchorElement} */ (document.getElementById('whatsapp-send')).href = buildWhatsAppUrl(message);

      showState('result');
      trackEvent('estimate_success');

      // The map is loaded only now, and only if it works: Leaflet, its CSS,
      // the stored geometries and the tiles are all fetched after the price
      // is already on screen (brief §7), and a failure just leaves the map
      // hidden (brief §5.3 — the call button must survive).
      const mapEl = document.getElementById('route-map');
      try {
        const { routePoints, showRoute } = await import('../lib/route-map.js');
        const points = await routePoints(destId, livePoints);
        mapEl.hidden = points.length < 2;
        if (!mapEl.hidden) {
          const shown = await showRoute(mapEl, points, `${fromVal} → ${destLabel}`);
          mapEl.hidden = !shown;
        }
      } catch {
        mapEl.hidden = true;
      }
    });

    document.getElementById('recompute-btn').addEventListener('click', () => {
      showState(null);
    });

    // --- arriving from the homepage teaser (?from=&dest=) ----------------
    // The teaser is a plain GET form, so `from` is free text from the URL:
    // it can be anything, including something someone else put in a link.
    // It is therefore treated exactly like text the visitor typed here —
    // capped at the field's own length, and unresolved until confirmed.
    const params = new URLSearchParams(window.location.search);
    const qFrom = params.get('from');
    const qDest = params.get('dest');
    if (qFrom) {
      const text = qFrom.slice(0, 120);
      fromInput.value = text;
      if (text !== BUSINESS.defaultPickup.label) fromField.clear();
    }
    if (qDest && DESTINATIONS.some((d) => d.id === qDest)) {
      destSelect.value = qDest;
      // Only compute straight away when the pickup point is known. Otherwise
      // offer the suggestions for what was passed in, rather than opening
      // the page on an error the visitor did not cause.
      if (fromField.value) {
        if (typeof form.requestSubmit === 'function') form.requestSubmit();
        else form.dispatchEvent(new Event('submit', { cancelable: true }));
      } else {
        fromField.prompt();
      }
    }
  }
</script>
