---
// Price simulator — hybrid architecture per the user's direction (2026-09-04):
// a dropdown of preset destinations (from the validated prototype, fixed
// km/min, airports marked "tbc") for the common case, plus a live address
// lookup via OpenRouteService for "other address" — reusing the geocoding
// module built for the CDC's original free-text-address design. Everything
// still runs entirely client-side (brief §1.1).
import { t } from '../i18n/dictionary.js';
import { DESTINATIONS } from '../data/destinations.js';
import CallButton from './CallButton.astro';

interface Props {
  locale: 'nl' | 'fr' | 'en';
}
const { locale } = Astro.props;
const s = t(locale);
---

<section class="sim-card" data-locale={locale} aria-labelledby="sim-title">
  <div>
    <h2 id="sim-title">{s.simTitle}</h2>
    <p class="notice">{s.simSub}</p>
  </div>

  <form id="sim-form" novalidate>
    <div class="field">
      <label class="field-label" for="from">{s.fFrom}</label>
      <input type="text" id="from" name="from" value="Grote Markt, Tienen" />
    </div>

    <div class="field">
      <label class="field-label" for="dest">{s.fTo}</label>
      <select id="dest" name="dest">
        <option value="">{s.fToPh}</option>
        {DESTINATIONS.map((d) => <option value={d.id}>{d[locale]}</option>)}
      </select>
    </div>

    <div class="field autocomplete-field" id="other-address-wrap" hidden>
      <label class="field-label" for="other-address">{s.fOtherAddress}</label>
      <input
        type="text"
        id="other-address"
        role="combobox"
        aria-expanded="false"
        aria-autocomplete="list"
        aria-controls="other-address-listbox"
        autocomplete="off"
        placeholder={s.fOtherAddressPh}
      />
      <ul id="other-address-listbox" role="listbox" class="suggestions" hidden></ul>
    </div>

    <div id="state-error" class="error-box" hidden>
      <span class="error-msg" id="error-text">{s.errBody}</span>
      <CallButton locale={locale} />
    </div>

    <div class="field-row">
      <div class="field">
        <label class="field-label" for="date">{s.fDate}</label>
        <input type="date" id="date" name="date" />
      </div>
      <div class="field">
        <label class="field-label" for="time">{s.fTime}</label>
        <input type="time" id="time" name="time" />
      </div>
    </div>

    <div class="field-row">
      <div class="field">
        <span class="field-label">{s.fPax}</span>
        <div class="counter">
          <span class="counter-value" id="pax-value">2</span>
          <span style="display:flex;gap:2px">
            <button class="qissi-tap" type="button" id="pax-down" aria-label="−">−</button>
            <button class="qissi-tap" type="button" id="pax-up" aria-label="+">+</button>
          </span>
        </div>
      </div>
      <div class="field">
        <span class="field-label">{s.fBags}</span>
        <div class="counter">
          <span class="counter-value" id="bags-value">1</span>
          <span style="display:flex;gap:2px">
            <button class="qissi-tap" type="button" id="bags-down" aria-label="−">−</button>
            <button class="qissi-tap" type="button" id="bags-up" aria-label="+">+</button>
          </span>
        </div>
      </div>
    </div>

    <div class="field">
      <label class="field-label" for="name">{s.fName}</label>
      <input type="text" id="name" name="name" placeholder={s.fNamePh} />
    </div>

    <div class="field">
      <label class="field-label" for="note">{s.fNote}</label>
      <textarea id="note" name="note" rows="2" placeholder={s.fNotePh}></textarea>
    </div>

    <p class="notice">{s.noPhone}</p>

    <div id="state-loading" hidden>
      <div style="display:flex;flex-direction:column;gap:12px;align-items:flex-start">
        <div style="width:100%;height:8px;border-radius:3px;background:#F4F4F5;overflow:hidden">
          <div id="loading-bar" style="width:60%;height:100%;background:var(--color-accent);border-radius:6px"></div>
        </div>
        <span class="notice" id="loading-text">{s.loading}</span>
      </div>
    </div>

    <div id="state-result" class="qissi-receipt" hidden>
      <div style="height:150px;background:#F4F4F5;border-radius:9px;overflow:hidden">
        <svg viewBox="0 0 460 150" width="100%" height="150" style="display:block">
          <path d="M40 120 C 130 106, 140 60, 210 50 S 350 40, 420 30" fill="none" stroke="var(--color-accent)" stroke-width="4" stroke-linecap="round"></path>
          <circle cx="40" cy="120" r="7" fill="#fff" stroke="var(--color-accent)" stroke-width="4"></circle>
          <circle cx="420" cy="30" r="7" fill="var(--color-accent)"></circle>
        </svg>
      </div>
      <div style="display:flex;flex-direction:column;gap:2px">
        <span style="font:600 15px/1.35 var(--font-body);color:var(--color-text)" id="route-label"></span>
        <span style="font:400 13.5px/1.35 var(--font-mono);color:var(--color-text-muted)" id="distance-label"></span>
      </div>
      <div style="display:flex;align-items:flex-end;justify-content:space-between;gap:16px;border-top:1px solid var(--color-border-strong);padding:16px 0 12px">
        <span style="display:flex;flex-direction:column;gap:5px">
          <span style="font:600 13.5px/1.3 var(--font-body);color:var(--color-text)">{s.resTitle}</span>
          <span id="indicative-badge" style="font:600 11px/1 var(--font-body);color:var(--color-accent-hover);letter-spacing:.05em">{s.indicative}</span>
        </span>
        <span id="price-label" style="font:700 44px/.9 var(--font-display);color:#0284C7;letter-spacing:-.03em;font-variant-numeric:tabular-nums;text-align:right"></span>
      </div>
      <div id="breakdown" style="display:flex;flex-direction:column;border-bottom:1px solid var(--color-border-strong);padding-bottom:14px">
        <div style="display:flex;justify-content:space-between;gap:12px;font:400 13px/1.8 var(--font-mono);color:var(--color-text-muted)"><span>{s.bPickup}</span><span id="line-pickup"></span></div>
        <div style="display:flex;justify-content:space-between;gap:12px;font:400 13px/1.8 var(--font-mono);color:var(--color-text-muted)"><span id="line-km-label"></span><span id="line-km-cost"></span></div>
        <div id="line-night" style="display:flex;justify-content:space-between;gap:12px;font:400 13px/1.8 var(--font-mono);color:var(--color-accent-hover)" hidden><span>{s.bNight}</span><span>+ 3 €</span></div>
      </div>
      <div id="tbc-note" style="display:flex;flex-direction:column;gap:10px;align-items:flex-start" hidden>
        <span class="notice">{s.tbcNote}</span>
        <CallButton locale={locale} />
      </div>
      <div style="display:flex;gap:12px;flex-wrap:wrap">
        <a id="whatsapp-send" class="btn btn-whatsapp qissi-tap" href="#" data-analytics="whatsapp_send">{s.waBtn}</a>
        <button type="button" class="btn btn-outline qissi-tap" id="recompute-btn">{s.recompute}</button>
      </div>
      <p class="notice">{s.whatsappDisclosure}</p>
      <div style="border-left:2px solid var(--color-border-strong);padding:2px 0 2px 14px;display:flex;flex-direction:column;gap:5px">
        <span style="font:600 11.5px/1 var(--font-body);color:var(--color-text-faint);letter-spacing:.06em;text-transform:uppercase">{s.msgTitle}</span>
        <span id="wa-message-preview" style="font:400 13.5px/1.6 var(--font-body);color:var(--color-text-muted)"></span>
      </div>
    </div>

    <button type="submit" class="btn btn-dark qissi-tap" id="compute-btn" data-analytics="simulator_open">{s.compute}</button>
  </form>
</section>

<style>
  .autocomplete-field {
    position: relative;
  }
  .suggestions {
    position: absolute;
    z-index: 20;
    top: 100%;
    left: 0;
    right: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    background: #fff;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius);
    max-height: 14rem;
    overflow-y: auto;
  }
  .suggestions li {
    padding: 0.6rem 0.75rem;
    cursor: pointer;
    min-height: 48px;
    display: flex;
    align-items: center;
  }
  .suggestions li[aria-selected='true'],
  .suggestions li:hover {
    background: var(--color-accent-tint);
  }
</style>

<script>
  import { autocompleteAddress, routeDistance, MapServiceError } from '../lib/geocoding.js';
  import { estimateFare } from '../lib/fare.js';
  import { buildWhatsAppMessage, buildWhatsAppUrl } from '../lib/whatsapp.js';
  import { t } from '../i18n/dictionary.js';
  import { DESTINATIONS } from '../data/destinations.js';
  import { BUSINESS } from '../config/business.js';
  import { trackEvent } from '../lib/analytics.js';

  const section = document.querySelector('.sim-card');
  if (section) {
    const locale = /** @type {'nl'|'fr'|'en'} */ (section.getAttribute('data-locale') ?? 'nl');
    const s = t(locale);
    const form = /** @type {HTMLFormElement} */ (document.getElementById('sim-form'));
    const destSelect = /** @type {HTMLSelectElement} */ (document.getElementById('dest'));
    const otherWrap = document.getElementById('other-address-wrap');
    const otherInput = /** @type {HTMLInputElement} */ (document.getElementById('other-address'));
    const otherListbox = /** @type {HTMLUListElement} */ (document.getElementById('other-address-listbox'));

    const states = {
      form: form,
      error: document.getElementById('state-error'),
      loading: document.getElementById('state-loading'),
      result: document.getElementById('state-result'),
    };
    const computeBtn = document.getElementById('compute-btn');

    function showState(name) {
      states.error.hidden = name !== 'error';
      states.loading.hidden = name !== 'loading';
      states.result.hidden = name !== 'result';
      computeBtn.hidden = name === 'loading' || name === 'result';
    }

    // --- pax / bags counters ------------------------------------------
    function setupCounter(prefix, min, max, initial) {
      const valueEl = document.getElementById(`${prefix}-value`);
      let value = initial;
      document.getElementById(`${prefix}-down`).addEventListener('click', () => {
        value = Math.max(min, value - 1);
        valueEl.textContent = String(value);
      });
      document.getElementById(`${prefix}-up`).addEventListener('click', () => {
        value = Math.min(max, value + 1);
        valueEl.textContent = String(value);
      });
      return () => value;
    }
    const getPax = setupCounter('pax', 1, 8, 2);
    const getBags = setupCounter('bags', 0, 8, 1);

    // --- destination select: reveal "other address" field --------------
    let otherCoord = null;
    destSelect.addEventListener('change', () => {
      const isOther = destSelect.value === 'other';
      otherWrap.hidden = !isOther;
      otherCoord = null;
      showState(null);
    });

    // --- accessible combobox for the "other address" lookup ------------
    let items = [];
    let activeIndex = -1;
    let debounceTimer;

    function closeList() {
      otherListbox.hidden = true;
      otherInput.setAttribute('aria-expanded', 'false');
      activeIndex = -1;
    }
    function renderList() {
      otherListbox.innerHTML = '';
      items.forEach((item, index) => {
        const li = document.createElement('li');
        li.role = 'option';
        li.id = `other-address-opt-${index}`;
        li.textContent = item.label;
        li.setAttribute('aria-selected', String(index === activeIndex));
        li.addEventListener('mousedown', (e) => {
          e.preventDefault();
          selectItem(index);
        });
        otherListbox.appendChild(li);
      });
      otherListbox.hidden = items.length === 0;
      otherInput.setAttribute('aria-expanded', String(items.length > 0));
    }
    function selectItem(index) {
      const item = items[index];
      if (!item) return;
      otherInput.value = item.label;
      otherCoord = { lon: item.lon, lat: item.lat, label: item.label };
      closeList();
    }
    otherInput.addEventListener('input', () => {
      otherCoord = null;
      clearTimeout(debounceTimer);
      const query = otherInput.value;
      debounceTimer = setTimeout(async () => {
        try {
          items = await autocompleteAddress(query);
          activeIndex = -1;
          renderList();
        } catch {
          items = [];
          closeList();
        }
      }, 300);
    });
    otherInput.addEventListener('keydown', (e) => {
      if (otherListbox.hidden) return;
      if (e.key === 'ArrowDown') {
        e.preventDefault();
        activeIndex = Math.min(activeIndex + 1, items.length - 1);
        renderList();
      } else if (e.key === 'ArrowUp') {
        e.preventDefault();
        activeIndex = Math.max(activeIndex - 1, 0);
        renderList();
      } else if (e.key === 'Enter') {
        if (activeIndex >= 0) {
          e.preventDefault();
          selectItem(activeIndex);
        }
      } else if (e.key === 'Escape') {
        closeList();
      }
    });
    otherInput.addEventListener('blur', () => setTimeout(closeList, 100));

    // --- compute --------------------------------------------------------
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const destId = destSelect.value;
      if (!destId) {
        document.getElementById('error-text').textContent = s.errBody;
        showState('error');
        return;
      }

      const time = /** @type {HTMLInputElement} */ (document.getElementById('time')).value;
      const hour = time ? parseInt(time.slice(0, 2), 10) : new Date().getHours();

      let km, min, destLabel, isTbc;

      if (destId === 'other') {
        if (!otherCoord) {
          document.getElementById('error-text').textContent = s.lookupError;
          showState('error');
          return;
        }
        showState('loading');
        document.getElementById('loading-text').textContent = s.lookupLoading;
        try {
          const route = await routeDistance(BUSINESS.geoMidpoint, otherCoord);
          km = route.km;
          min = route.min;
          destLabel = otherCoord.label;
          isTbc = false;
        } catch (err) {
          document.getElementById('error-text').textContent = s.lookupError;
          showState('error');
          if (!(err instanceof MapServiceError)) console.error(err);
          return;
        }
      } else {
        const dest = DESTINATIONS.find((d) => d.id === destId);
        showState('loading');
        document.getElementById('loading-text').textContent = s.loading;
        await new Promise((r) => setTimeout(r, 700));
        km = dest.km;
        min = dest.min;
        destLabel = dest[locale];
        isTbc = !!dest.tbc;
      }

      const fare = estimateFare(km, ((hour % 24) + 24) % 24);
      const fromVal = /** @type {HTMLInputElement} */ (document.getElementById('from')).value;
      const dateVal = /** @type {HTMLInputElement} */ (document.getElementById('date')).value;
      const nameVal = /** @type {HTMLInputElement} */ (document.getElementById('name')).value;
      const noteVal = /** @type {HTMLTextAreaElement} */ (document.getElementById('note')).value;
      const pax = getPax();
      const bags = getBags();

      document.getElementById('route-label').textContent = `${fromVal} → ${destLabel}`;
      document.getElementById('distance-label').textContent = isTbc
        ? s.tbcDist
        : `${km} km · ~${min} min`;
      document.getElementById('price-label').textContent = isTbc ? s.tbcPrice : `${fare.total.toFixed(2)} €`;
      document.getElementById('price-label').style.fontSize = isTbc ? '26px' : '44px';
      document.getElementById('indicative-badge').hidden = isTbc;
      document.getElementById('breakdown').hidden = isTbc;
      document.getElementById('line-pickup').textContent = `${fare.breakdown.base.toFixed(2)} €`;
      document.getElementById('line-km-label').textContent = `${km} km × 3 €`;
      document.getElementById('line-km-cost').textContent = `${fare.breakdown.distance.toFixed(2)} €`;
      document.getElementById('line-night').hidden = !fare.isNight;
      document.getElementById('tbc-note').hidden = !isTbc;

      const message = buildWhatsAppMessage({
        locale,
        form: { from: fromVal, destLabel, date: dateVal, time, pax, bags, name: nameVal, note: noteVal },
        fare: { total: fare.total, isTbc },
      });
      document.getElementById('wa-message-preview').textContent = `« ${message} »`;
      const waBtn = /** @type {HTMLAnchorElement} */ (document.getElementById('whatsapp-send'));
      waBtn.href = buildWhatsAppUrl(message);

      showState('result');
      trackEvent('estimate_success');
    });

    document.getElementById('recompute-btn').addEventListener('click', () => {
      showState(null);
    });

    // --- arriving from the homepage teaser (?from=&dest=) ----------------
    const params = new URLSearchParams(window.location.search);
    const qFrom = params.get('from');
    const qDest = params.get('dest');
    if (qFrom) /** @type {HTMLInputElement} */ (document.getElementById('from')).value = qFrom;
    if (qDest && DESTINATIONS.some((d) => d.id === qDest)) {
      destSelect.value = qDest;
      if (typeof form.requestSubmit === 'function') form.requestSubmit();
      else form.dispatchEvent(new Event('submit', { cancelable: true }));
    }
  }
</script>
