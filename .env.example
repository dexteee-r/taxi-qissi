# Copy to .env and fill in. Never commit the real .env file.

# OpenRouteService API key (https://openrouteservice.org/dev/)
# Used by the simulator and by scripts/verify-distances.mjs. Since both
# address fields became free text, every estimate calls this API: without a
# key the simulator can produce no price at all.
#
# Note: this key necessarily ends up in the browser bundle — the brief (§1.1)
# rules out a server-side proxy, so the routing call is made client-side.
# It is injected at build time (see astro.config.mjs), which is why it does
# NOT need a PUBLIC_ prefix; hosting dashboards flag that prefix as a leak.
# PUBLIC_ORS_API_KEY is still read as a fallback for older setups.
#
# Restrict it and cap its daily quota in the ORS dashboard before go-live
# (brief §5.4). The quota is the real guard rail, not the key's secrecy.
ORS_API_KEY=

# Cookie-less analytics (Umami, self-hosted — see src/lib/analytics.js).
# Leave both empty to ship no analytics at all (dev / pre-launch).
# These do need the PUBLIC_ prefix: they are read at runtime in the page.
# PUBLIC_UMAMI_SRC=https://analytics.example.be/script.js
# PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_SRC=
PUBLIC_UMAMI_WEBSITE_ID=
