# Copy to .env and fill in. Never commit the real .env file.

# OpenRouteService API key (https://openrouteservice.org/dev/#/signup)
# Only used by the simulator's "other address" option (the dropdown
# destinations need no network call at all).
# Restrict by HTTP referrer + set a daily quota cap in the ORS dashboard
# before go-live (brief_dev_taxi_qiss.md §5.4).
PUBLIC_ORS_API_KEY=

# Cookie-less analytics (Umami, self-hosted — see src/lib/analytics.js).
# Leave both empty to ship no analytics at all (dev / pre-launch).
# PUBLIC_UMAMI_SRC=https://analytics.example.be/script.js
# PUBLIC_UMAMI_WEBSITE_ID=
PUBLIC_UMAMI_SRC=
PUBLIC_UMAMI_WEBSITE_ID=
