{
  "name": "taxi-qissi-repo-github",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "verify:distances": "node scripts/verify-distances.mjs --ors",
    "verify:distances:write": "node scripts/verify-distances.mjs --ors --write"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "astro": "^7.3.1",
    "leaflet": "^1.9.4"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "vitest": "^5.0.0"
  }
}
